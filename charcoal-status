#!/usr/bin/env bash
# Report installed Charcoal kernel packages, build configuration, and runtime state.
set -uo pipefail

PASS=0
WARN=0
FAIL=0
INFO=0

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; CYAN=$'\033[36m'; RESET=$'\033[0m'
else
  GREEN=""; YELLOW=""; RED=""; CYAN=""; RESET=""
fi

pass() { printf '  %s[PASS]%s %s\n' "$GREEN" "$RESET" "$*"; PASS=$((PASS + 1)); }
warn() { printf '  %s[WARN]%s %s\n' "$YELLOW" "$RESET" "$*"; WARN=$((WARN + 1)); }
fail() { printf '  %s[FAIL]%s %s\n' "$RED" "$RESET" "$*"; FAIL=$((FAIL + 1)); }
info() { printf '  %s[INFO]%s %s\n' "$CYAN" "$RESET" "$*"; INFO=$((INFO + 1)); }
section() { printf '\n%s\n' "$*"; }

RUNNING_KERNEL=$(uname -r)
RUNNING_MODULE_DIR="/usr/lib/modules/$RUNNING_KERNEL"
CONFIG_FILE=""
BUILD_DIR=""
CHARCOAL_MODULE_DIR=""

# Find the installed Charcoal package dynamically (7.2, 7.3, and later).
mapfile -t CHARCOAL_PACKAGES < <(pacman -Qq 2>/dev/null | grep -E '^linux-charcoal-[0-9]+$' | sort -V || true)
if (( ${#CHARCOAL_PACKAGES[@]} > 0 )); then
  CHARCOAL_PACKAGE="${CHARCOAL_PACKAGES[-1]}"
  KERNEL_SERIES="${CHARCOAL_PACKAGE##*-}"
  HEADERS_PACKAGE="${CHARCOAL_PACKAGE}-headers"
else
  CHARCOAL_PACKAGE=""
  KERNEL_SERIES=""
  HEADERS_PACKAGE=""
fi

# A pkgbase marker alone is not sufficient to attribute a running kernel to
# Charcoal: verify that pacman says the running module directory belongs to
# the installed Charcoal package.
if [[ -n "$CHARCOAL_PACKAGE" ]]; then
  for module_dir in /usr/lib/modules/*; do
    [[ -f "$module_dir/pkgbase" ]] || continue
    [[ "$(<"$module_dir/pkgbase")" == "linux-neptune-$KERNEL_SERIES" ]] || continue
    owner=$(pacman -Qqo -- "$module_dir/pkgbase" 2>/dev/null || true)
    if [[ "$owner" == "$CHARCOAL_PACKAGE" ]]; then
      CHARCOAL_MODULE_DIR="$module_dir"
      break
    fi
  done
fi

# Prefer the running Charcoal kernel's config. If this is not yet the running
# kernel, inspect the installed Charcoal module tree's saved build config.
if [[ -n "$CHARCOAL_PACKAGE" && -f "$RUNNING_MODULE_DIR/pkgbase" ]]; then
  running_owner=$(pacman -Qqo -- "$RUNNING_MODULE_DIR/pkgbase" 2>/dev/null || true)
  if [[ "$running_owner" == "$CHARCOAL_PACKAGE" && -r /proc/config.gz ]] && command -v zcat >/dev/null 2>&1; then
    CONFIG_FILE=$(mktemp)
    if zcat /proc/config.gz > "$CONFIG_FILE" 2>/dev/null; then
      BUILD_DIR="$RUNNING_MODULE_DIR/build"
    else
      rm -f "$CONFIG_FILE"
      CONFIG_FILE=""
    fi
  fi
fi

if [[ -z "$CONFIG_FILE" && -n "$CHARCOAL_MODULE_DIR" && -r "$CHARCOAL_MODULE_DIR/build/.config" ]]; then
  CONFIG_FILE="$CHARCOAL_MODULE_DIR/build/.config"
  BUILD_DIR="$CHARCOAL_MODULE_DIR/build"
fi
if [[ -z "$CONFIG_FILE" && -r "/boot/config-$RUNNING_KERNEL" ]]; then
  CONFIG_FILE="/boot/config-$RUNNING_KERNEL"
fi
if [[ -z "$CONFIG_FILE" && -r /proc/config.gz ]] && command -v zcat >/dev/null 2>&1; then
  CONFIG_FILE=$(mktemp)
  if ! zcat /proc/config.gz > "$CONFIG_FILE" 2>/dev/null; then
    rm -f "$CONFIG_FILE"
    CONFIG_FILE=""
  fi
fi
if [[ "${CONFIG_FILE:-}" == /tmp/* ]]; then
  trap '[[ -n "${CONFIG_FILE:-}" && -f "$CONFIG_FILE" ]] && rm -f "$CONFIG_FILE"' EXIT
fi

config_enabled() {
  local symbol=$1
  [[ -n "$CONFIG_FILE" ]] && grep -qxE "$symbol=(y|m)" "$CONFIG_FILE"
}
config_value() {
  local symbol=$1 value=$2
  [[ -n "$CONFIG_FILE" ]] && grep -qxF "$symbol=$value" "$CONFIG_FILE"
}
config_disabled() {
  local symbol=$1
  [[ -n "$CONFIG_FILE" ]] && { grep -qxF "$symbol=n" "$CONFIG_FILE" || grep -qxF "# $symbol is not set" "$CONFIG_FILE"; }
}
check_config() {
  local symbol=$1 description=$2
  if [[ -z "$CONFIG_FILE" ]]; then
    warn "$description: kernel .config unavailable; cannot verify build option"
  elif config_enabled "$symbol"; then
    pass "$description: enabled in kernel config"
  else
    fail "$description: $symbol is not enabled in the installed Charcoal kernel config"
  fi
}

printf 'Charcoal kernel status\n'
printf 'Running kernel: %s\n' "$RUNNING_KERNEL"

if [[ -z "$CHARCOAL_PACKAGE" ]]; then
  fail "No linux-charcoal kernel package is installed"
else
  package_version=$(pacman -Q "$CHARCOAL_PACKAGE" 2>/dev/null | awk '{print $2}')
  pass "Charcoal kernel package installed: $CHARCOAL_PACKAGE $package_version"
  if pacman -Q "$HEADERS_PACKAGE" >/dev/null 2>&1; then
    pass "Charcoal headers package installed ($HEADERS_PACKAGE)"
  else
    warn "Charcoal headers package $HEADERS_PACKAGE is not installed; DKMS/external module builds may need it"
  fi
fi

if [[ -n "$CHARCOAL_PACKAGE" && -d "$RUNNING_MODULE_DIR" ]]; then
  running_pkgbase=""
  [[ -r "$RUNNING_MODULE_DIR/pkgbase" ]] && running_pkgbase=$(<"$RUNNING_MODULE_DIR/pkgbase")
  running_owner=$(pacman -Qqo -- "$RUNNING_MODULE_DIR/pkgbase" 2>/dev/null || true)
  if [[ "$running_pkgbase" == "linux-neptune-$KERNEL_SERIES" && "$running_owner" == "$CHARCOAL_PACKAGE" ]]; then
    pass "Running kernel module tree is owned by $CHARCOAL_PACKAGE"
  elif [[ "$running_pkgbase" == "linux-neptune-$KERNEL_SERIES" ]]; then
    warn "Running module tree has the expected $running_pkgbase boot identity, but pacman does not attribute it to $CHARCOAL_PACKAGE"
  else
    warn "Running module tree is not identified as this Charcoal series (pkgbase: ${running_pkgbase:-missing}; owner: ${running_owner:-unknown})"
  fi
elif [[ -n "$CHARCOAL_PACKAGE" ]]; then
  warn "No module directory exists for the running kernel release"
fi

section "Kernel security and CPU target"
if [[ -z "$CONFIG_FILE" ]]; then
  warn "CPU mitigations: kernel .config unavailable; cannot verify CONFIG_CPU_MITIGATIONS"
elif config_disabled CONFIG_CPU_MITIGATIONS; then
  pass "CPU mitigation framework is disabled at build time (CONFIG_CPU_MITIGATIONS=n)"
elif config_enabled CONFIG_CPU_MITIGATIONS; then
  fail "CPU mitigation framework is compiled in (CONFIG_CPU_MITIGATIONS=y); expected it disabled at build time"
  info "mitigations=off is a runtime control and is not equivalent to compiling CONFIG_CPU_MITIGATIONS=n"
else
  warn "CONFIG_CPU_MITIGATIONS is absent from the selected config; cannot determine its build state"
fi

if [[ -n "$CONFIG_FILE" ]]; then
  cpu_targets=()
  for symbol in CONFIG_MZEN2 CONFIG_MZEN3 CONFIG_MZEN4 CONFIG_MZEN5 CONFIG_X86_NATIVE_CPU CONFIG_GENERIC_CPU; do
    config_enabled "$symbol" && cpu_targets+=("$symbol")
  done
  if (( ${#cpu_targets[@]} > 0 )); then
    info "CPU target config: ${cpu_targets[*]}"
  else
    info "No generic/native CPU selector symbol found; not treating CONFIG_GENERIC_CPU absence as a failure"
  fi
fi
printf '  Architecture reported by uname: %s\n' "$(uname -m)"
printf '  Exact -march/-mtune flags are not encoded in the kernel .config.\n'

compiler=""
if [[ -n "$BUILD_DIR" && -r "$BUILD_DIR/include/generated/compile.h" ]]; then
  compiler=$(sed -n 's/^#define LINUX_COMPILER "\(.*\)"/\1/p' "$BUILD_DIR/include/generated/compile.h" | head -n1)
fi
if [[ -n "$compiler" ]]; then
  pass "Kernel build compiler metadata: $compiler"
elif [[ -r /proc/version ]] && grep -Eqi 'clang|gcc|GCC' /proc/version; then
  compiler=$(sed -E 's/.*(clang version [^,)]*|gcc version [^,)]*|GCC version [^,)]*).*/\1/I' /proc/version)
  info "Compiler reported by the running kernel: $compiler (generated compile.h unavailable)"
else
  warn "Compiler version unavailable; no embedded build metadata found"
fi

section "Kernel features (selected Charcoal kernel configuration)"
check_config CONFIG_SCHED_BORE "BORE scheduler"
check_config CONFIG_SCHED_POC_SELECTOR "POC CPU selector"
check_config CONFIG_LRU_CAST "LRU CAST page reclaim"
check_config CONFIG_ZRAM "ZRAM support"
check_config CONFIG_ZRAM_MULTI_COMP "ZRAM multi-compression / recompression"
check_config CONFIG_X86_AMD_PSTATE "AMD P-State"
check_config CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3 "O3 optimization"
check_config CONFIG_LTO_CLANG_FULL "Full Clang LTO"
check_config CONFIG_POLLY_CLANG "Clang Polly"

if [[ -n "$CONFIG_FILE" ]]; then
  if config_value CONFIG_X86_AMD_PSTATE_DEFAULT_MODE 3; then
    pass "AMD P-State default mode: active (EPP)"
  else
    warn "AMD P-State default mode is not configured as active (EPP)"
  fi
  if config_disabled CONFIG_JOYSTICK_XPAD; then
    warn "Built-in xpad controller driver is disabled in this kernel config"
  else
    pass "Built-in xpad controller driver is not explicitly disabled"
  fi
fi

section "NAP cpuidle governor"
if [[ -z "$CONFIG_FILE" ]]; then
  warn "NAP governor build option cannot be checked without the kernel .config"
elif config_enabled CONFIG_CPU_IDLE_GOV_NAP; then
  pass "NAP cpuidle governor is built into the kernel"
elif config_disabled CONFIG_CPU_IDLE_GOV_NAP; then
  info "NAP cpuidle governor is disabled in this build (expected for the current 7.3 configuration)"
else
  info "NAP cpuidle governor option is absent from this kernel config"
fi
governor_file=/sys/devices/system/cpu/cpuidle/current_governor
available_file=/sys/devices/system/cpu/cpuidle/available_governors
if [[ -r "$available_file" ]] && grep -qw nap "$available_file"; then
  if [[ -r "$governor_file" && "$(<"$governor_file")" == "nap" ]]; then
    pass "NAP is the active cpuidle governor"
  else
    info "NAP is available but not selected"
  fi
elif [[ -r "$governor_file" ]]; then
  info "NAP is not exposed by the running kernel (expected because the governor was removed)"
else
  info "cpuidle governor sysfs interface is unavailable"
fi

section "ADIOS I/O scheduler"
adios_selected=0
adios_available=0
scheduler_devices=0
for scheduler_file in /sys/block/*/queue/scheduler; do
  [[ -r "$scheduler_file" ]] || continue
  scheduler_devices=$((scheduler_devices + 1))
  schedulers=$(<"$scheduler_file")
    grep -q '\[adios\]' <<< "$schedulers" && adios_selected=$((adios_selected + 1))
    adios_available=$((adios_available + 1))
    grep -q '\[adios\]' <<< "$schedulers" && adios_selected=$((adios_selected + 1))
  fi
done
if (( adios_selected > 0 )); then
  pass "ADIOS selected on $adios_selected block device(s) ($adios_available expose it)"
elif (( adios_available > 0 )); then
  warn "ADIOS available on $adios_available block device(s), but not selected"
elif (( scheduler_devices > 0 )); then
  fail "ADIOS is not available on any detected block device"
else
  warn "No block-device scheduler interfaces found"
fi

section "ZRAM-IR"
if [[ -r /proc/sys/vm/zram_recomp_immediate ]]; then
  immediate=$(</proc/sys/vm/zram_recomp_immediate)
  if [[ "$immediate" == "1" ]]; then
    pass "zram_recomp_immediate=1"
  else
    fail "zram_recomp_immediate is $immediate (expected 1)"
  fi
else
  warn "zram_recomp_immediate sysctl is unavailable"
fi
if [[ -f /usr/lib/udev/rules.d/60-charcoal-zram-ir.rules && -x /usr/lib/charcoal/configure-zram-ir ]]; then
  pass "ZRAM-IR udev rule and configuration helper are installed"
else
  fail "ZRAM-IR udev rule or configuration helper is missing"
fi
if [[ -f /usr/lib/systemd/system/systemd-zram-setup@.service.d/90-charcoal-zram-ir.conf ]]; then
  pass "ZRAM-IR systemd setup drop-in is installed"
else
  warn "ZRAM-IR systemd setup drop-in is missing"
fi
zram_count=0
zram_ready=0
for zram_dir in /sys/block/zram[0-9]*; do
  [[ -d "$zram_dir" ]] || continue
  zram_count=$((zram_count + 1))
  comp=""
  recomp=""
  [[ -r "$zram_dir/comp_algorithm" ]] && comp=$(<"$zram_dir/comp_algorithm")
  [[ -r "$zram_dir/recomp_algorithm" ]] && recomp=$(<"$zram_dir/recomp_algorithm")
  if grep -q '\[lz4\]' <<< "$comp" && grep -Eq '\[algo=zstd\]|\[zstd\]|algo=zstd' <<< "$recomp"; then
    zram_ready=$((zram_ready + 1))
    pass "$(basename "$zram_dir") uses LZ4 primary compression and ZSTD recompression"
  else
    warn "$(basename "$zram_dir") compressor setup does not show LZ4 + ZSTD (primary: ${comp:-unknown}; recompress: ${recomp:-unavailable})"
  fi
done
if (( zram_count == 0 )); then
  warn "No active zram device found; ZRAM runtime settings will be checked after zram is created"
elif (( zram_ready == zram_count )); then
  pass "ZRAM-IR compressor configuration verified on all $zram_count device(s)"
fi

section "AMD P-State EPP"
pstate_status=/sys/devices/system/cpu/amd_pstate/status
if [[ -r "$pstate_status" ]]; then
  pstate=$(<"$pstate_status")
  if [[ "$pstate" == "active" ]]; then
    pass "AMD P-State driver reports active mode"
  else
    warn "AMD P-State status is $pstate (expected active)"
  fi
else
  warn "AMD P-State status sysfs interface unavailable (hardware/driver dependent)"
fi
epp_count=0
for epp_file in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/energy_performance_preference; do
  [[ -r "$epp_file" ]] || continue
  epp_count=$((epp_count + 1))
done
if (( epp_count > 0 )); then
  pass "EPP preference interface exposed for $epp_count CPU(s)"
else
  warn "No per-CPU EPP preference interfaces found"
fi
if grep -qw 'amd_pstate.epp_boost=1' /proc/cmdline 2>/dev/null; then
  pass "amd_pstate.epp_boost=1 is present on the running kernel command line"
else
  warn "amd_pstate.epp_boost=1 not visible in /proc/cmdline (verify bootloader/built-in command line)"
fi

section "Summary"
printf '  PASS: %d   INFO: %d   WARN: %d   FAIL: %d\n' "$PASS" "$INFO" "$WARN" "$FAIL"
if (( FAIL > 0 )); then
  printf 'Some checks failed. Review the items above.\n'
  exit 1
elif (( WARN > 0 )); then
  printf 'Some checks need attention or a runtime environment to verify.\n'
else
  printf 'All detected checks passed; informational items are not failures.\n'
fi
