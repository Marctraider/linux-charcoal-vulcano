# Charcoal SteamOS 3.10 / Linux 7.3 minimal performance overlay.
# Valve's exact Steam Deck hardware configuration remains the base.

CONFIG_EXPERT=y

# AMD Zen 2 / Van Gogh target is passed to Clang by PKGBUILD as -march=znver2.
# Keep AMD P-State active mode and the requested EPP boost / mitigation defaults.
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_CPU_MITIGATIONS=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="amd_pstate.epp_boost=1 mitigations=off"
# CONFIG_CMDLINE_OVERRIDE is not set

# O2 is the kernel's performance optimization level.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3 is not set

# Retain the requested Clang toolchain optimizations.
CONFIG_LTO_CLANG_FULL=y
CONFIG_POLLY_CLANG=y

# BORE modifies the fair scheduler and remains the in-kernel fallback.
CONFIG_SCHED_BORE=y

# LAVD requires sched_ext, BPF JIT and vmlinux BTF.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_SCHED_CLASS_EXT=y

# BTF needs DWARF type information. This metadata has no normal runtime
# instrumentation cost; module BTF is unnecessary for LAVD.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
# CONFIG_DEBUG_INFO_NONE is not set

# Retain syscall tracepoints for LAVD futex tracking. The tracing framework
# has no per-function instrumentation because function tracers remain disabled.
CONFIG_TRACEPOINTS=y
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_SCHED_DEBUG=n
CONFIG_FUNCTION_TRACER=n
CONFIG_FUNCTION_GRAPH_TRACER=n
CONFIG_KPROBES=n
CONFIG_PROFILING=n
CONFIG_LOCKDEP=n
CONFIG_PROVE_LOCKING=n
CONFIG_DEBUG_ATOMIC_SLEEP=n
CONFIG_DEBUG_MUTEXES=n
CONFIG_DEBUG_SPINLOCK=n
CONFIG_DEBUG_LIST=n
CONFIG_DEBUG_OBJECTS=n
CONFIG_DEBUG_PAGEALLOC=n
CONFIG_PAGE_POISONING=n
CONFIG_SLUB_DEBUG=n
CONFIG_KASAN=n
CONFIG_KCSAN=n
CONFIG_KFENCE=n
CONFIG_KMSAN=n
CONFIG_UBSAN=n
